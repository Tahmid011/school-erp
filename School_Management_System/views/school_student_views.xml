<odoo>

    <record id="view_school_student_tree" model="ir.ui.view">
        <field name="name">school.student.tree</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="student_code"/>
                <field name="roll_number" groups="School_Management_System.group_school_admin,School_Management_System.group_school_registrar"/>
                <field name="roll_number" readonly="1" groups="School_Management_System.group_school_teacher"/>
                <field name="date_of_birth"/>
                <field name="section"/>
                <field name="parent_contact"/>
                <field name="class_id"/>
            </tree>
        </field>
    </record>

    <record id="view_school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_guardians" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="guardian_count" widget="statinfo" string="Guardians"/>
                        </button>
                        <button name="action_open_contact" type="object" class="oe_stat_button" icon="fa-address-card">
                            <span class="o_stat_text">Contact</span>
                        </button>
                        <button name="action_view_exam_results" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="exam_result_count" widget="statinfo" string="Exam Results"/>
                        </button>
                    </div>
                    <group>
                        <field name="photo" widget="image" class="oe_avatar"/>
                        <field name="name"/>
                        <field name="student_code"/>
                        <field name="roll_number"/>
                        <field name="date_of_birth"/>
                        <field name="gender"/>
                        <field name="blood_group"/>
                    </group>
                    <group>
                        <field name="class_id"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="address"/>
                        <field name="parent_contact"/>
                        <field name="section"/>
                        <field name="admission_id" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_school_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No student records found. Click to create a new student record.
            </p>
        </field>
    </record>

    <record id="sequence_school_student" model="ir.sequence">
        <field name="name">School Student Reference Code</field>
        <field name="prefix">STU/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="code">school.student</field>
    </record>

</odoo>