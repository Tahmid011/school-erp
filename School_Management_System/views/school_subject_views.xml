<odoo>
    <record id="view_school_subject_tree" model="ir.ui.view">
        <field name="name">school.subject.tree</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <tree string="Subjects">
                <field name="subject_code"/>
                <field name="class_id"/>
                <field name="name"/>
                <field name="teacher_id"/>
            </tree>
        </field>
    </record>

    <record id="view_school_subject_form" model="ir.ui.view">
        <field name="name">school.subject.form</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <group>
                        <field name="subject_code"/>
                        <field name="class_id"/>
                        <field name="name"/>
                        <field name="teacher_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sequence_school_subject" model="ir.sequence">
        <field name="name">School Subject Reference Code</field>
        <field name="prefix">CC</field>
        <field name="padding">2</field>
        <field name="number_increment">1</field>
        <field name="code">school.subject</field>
    </record>

    <record id="action_school_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No subject records found. Click to create a new subject record.
            </p>
        </field>
    </record>

</odoo>