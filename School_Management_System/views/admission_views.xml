<odoo>
    <record id="view_student_admission_tree" model="ir.ui.view">
        <field name="name">student.admission.tree</field>
        <field name="model">student.admission</field>
        <field name="arch" type="xml">
            <tree string="Admission">
                <field name="application_number"/>
                <field name="name"/>
                <field name="applying_for_class_id"/>
                <field name="entrance_test_score"/>
                <field name="state"/>
                <field name="reviewer_id"/>
            </tree>
        </field>
    </record>

    <record id="view_student_admission_form" model="ir.ui.view">
        <field name="name">student.admission.form</field>
        <field name="model">student.admission</field>
        <field name="arch" type="xml">
            <form string="Admission">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under review,approved,waitlisted,rejected,admitted"/>
                    <button name="action_submit" type="object" string="Submit" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_under_review" type="object" string="Under Review" invisible="state != 'submitted'" class="oe_highlight"/>
                    <button name="action_approve" type="object" string="Approve" invisible="state != 'under review'" class="oe_highlight"/>
                    <button name="action_waitlist" type="object" string="Waitlist" invisible="state not in ('under review', 'approved')" class="btn-secondary"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'under review'" class="btn-secondary"/>
                    <button name="action_admit" type="object" string="Admit" invisible="state != 'approved'" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="application_number"/>
                            <field name="name"/>
                            <field name="date_of_birth"/>
                            <field name="photo" widget="image" class="oe_avatar"/>
                            <field name="previous_school"/>
                        </group>
                        <group>
                            <field name="applying_for_class_id"/>
                            <field name="class_id" readonly="1"/>
                            <field name="section"/>
                            <field name="entrance_test_score"/>
                            <field name="reviewer_id"/>
                            <field name="student_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Guardian Details">
                            <group>
                                <group string="Father">
                                    <field name="father_name"/>
                                    <field name="father_phone"/>
                                    <field name="father_email"/>
                                    <field name="father_occupation"/>
                                </group>
                                <group string="Mother">
                                    <field name="mother_name"/>
                                    <field name="mother_phone"/>
                                    <field name="mother_email"/>
                                    <field name="mother_occupation"/>
                                </group>
                                <group string="Legacy Guardian Contact">
                                    <field name="parent_contact"/>
                                    <field name="guardian_email"/>
                                </group>
                            </group>
                        </page>
                        <page string="Address and Documents">
                            <field name="address"/>
                            <field name="document_ids">
                                <tree editable="bottom">
                                    <field name="document_type"/>
                                    <field name="attachment_id"/>
                                    <field name="required"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_student_admission_search" model="ir.ui.view">
        <field name="name">student.admission.search</field>
        <field name="model">student.admission</field>
        <field name="arch" type="xml">
            <search string="Admission Search">
                <field name="application_number"/>
                <field name="name"/>
                <field name="applying_for_class_id"/>
                <field name="entrance_test_score"/>
                <field name="state"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Under Review" name="under_review" domain="[('state','=','under review')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Waitlisted" name="waitlisted" domain="[('state','=','waitlisted')]"/>
                <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
                <filter string="Admitted" name="admitted" domain="[('state','=','admitted')]"/>
                <group expand="1" string="Group By">
                    <filter string="Applying Class" name="applying_class" context="{'group_by':'applying_for_class_id'}"/>
                    <filter string="State" name="state_group" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_student_admission" model="ir.actions.act_window">
        <field name="name">Admission</field>
        <field name="res_model">student.admission</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_student_admission_merit" model="ir.actions.act_window">
        <field name="name">Merit Ranking</field>
        <field name="res_model">student.admission</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_applying_class': 1}</field>
        <field name="domain">[('entrance_test_score', '!=', False)]</field>
    </record>
</odoo>
