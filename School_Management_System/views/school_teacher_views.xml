<odoo>
    <record id="view_school_teacher_tree" model="ir.ui.view">
        <field name="name">school.teacher.tree</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <tree string="Teachers">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="contact_number"/>
                <field name="subject"/>
                <field name="class_ids"/>

            </tree>
        </field>
    </record>

    <record id="view_school_teacher_form" model="ir.ui.view">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form string="Teachers">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_exams" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="exam_count" widget="statinfo" string="Exams"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="name"/>
                            <field name="contact_number"/>
                            <field name="subject"/>
                            <field name="class_ids" widget="many2many_tags"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="degree"/>
                            <field name="experience"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sequence_school_teacher" model="ir.sequence">
        <field name="name">School Teacher Reference Code</field>
        <field name="prefix">TC</field>
        <field name="padding">2</field>
        <field name="number_increment">1</field>
        <field name="code">school.teacher</field>
    </record>

    <record id="action_school_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No teacher records found. Click to create a new teacher record.
            </p>
        </field>
    </record>
</odoo>