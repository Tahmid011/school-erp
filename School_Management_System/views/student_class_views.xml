<odoo>
    <record id="view_student_class_tree" model="ir.ui.view">
        <field name="name">student.class.tree</field>
        <field name="model">student.class</field>
        <field name="arch" type="xml">
            <tree string="Class" editable="bottom">
                <field name="reference_code"/>
                <field name="name"/>
                <field name="section_id"/>
                <field name="academic_year_id"/>
                <field name="class_teacher_id"/>
                <field name="total_seat"/>
                <field name="total_students"/>
                <field name="available_seat"/>
            </tree>
        </field>
    </record>
 
    <record id="view_student_class_form" model="ir.ui.view">
        <field name="name">student.class.form</field>
        <field name="model">student.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_exams" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="exam_count" widget="statinfo" string="Exams"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="reference_code"/>
                            <field name="name"/>
                            <field name="section_id"/>
                            <field name="academic_year_id"/>
                            <field name="class_teacher_id"/>
                        </group>
                        <group>
                            <field name="total_seat"/>
                            <field name="total_students"/>
                            <field name="available_seat"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sequence_student_class" model="ir.sequence">
        <field name="name">Student Class Reference Code</field>
        <field name="prefix">SC</field>
        <field name="padding">2</field>
        <field name="number_increment">1</field>
        <field name="code">student.class</field>
    </record>

    <record id="action_student_class" model="ir.actions.act_window">
        <field name="name">Class</field>
        <field name="res_model">student.class</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No class records found. Click to create a new class record.
            </p>
        </field>
    </record>
</odoo>