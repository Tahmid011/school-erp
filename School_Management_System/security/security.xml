<odoo>
    <data noupdate="0">
        <record id="module_category_school" model="ir.module.category">
                <field name="name">School</field>
                <field name="sequence">1</field>
        </record>
        <record id="group_school_admin" model="res.groups">
            <field name="name">Admin / Principal</field>
            <field name="category_id" ref="School_Management_System.module_category_school"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">This user will have access to all school management features</field>
        </record>

        <record id="group_school_teacher" model="res.groups">
            <field name="name">Teacher</field>
            <field name="category_id" ref="School_Management_System.module_category_school"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">This user will have access to teacher-specific features</field>
        </record>

        <record id="group_school_registrar" model="res.groups">
            <field name="name">Registrar</field>
            <field name="category_id" ref="School_Management_System.module_category_school"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">This user manages student admissions and records.</field>
        </record>

        <record id="group_school_accountant" model="res.groups">
            <field name="name">Accountant</field>
            <field name="category_id" ref="School_Management_System.module_category_school"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
            <field name="comment">This user manages school fees and invoices.</field>
        </record>

        <record id="group_school_student" model="res.groups">
            <field name="name">Student</field>
            <field name="category_id" ref="School_Management_System.module_category_school"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">This user can view their own student record, results, and invoices.</field>
        </record>

        <record id="group_school_parent" model="res.groups">
            <field name="name">Parent</field>
            <field name="category_id" ref="School_Management_System.module_category_school"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">This user can view records for linked children.</field>
        </record>

        <record id="school_admin_rule" model="ir.rule">
            <field name="name">Admin: view all records</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_admin')])]"/>
            <field name="domain_force">[]</field>
        </record>

        <record id="school_teacher_rule" model="ir.rule">
            <field name="name">Teacher: view taught classes and own classes</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_teacher')])]"/>
            <field name="domain_force">['|', ('class_id.class_teacher_id.user_id', '=', user.id), ('class_id.subject_ids.teacher_id.user_id', '=', user.id)]</field>
        </record>

        <record id="school_student_registrar_rule" model="ir.rule">
            <field name="name">Registrar: view all students</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_registrar')])]"/>
            <field name="domain_force">[]</field>
        </record>

        <record id="school_student_accountant_rule" model="ir.rule">
            <field name="name">Accountant: read all students</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_accountant')])]"/>
            <field name="domain_force">[]</field>
        </record>

        <record id="school_student_student_rule" model="ir.rule">
            <field name="name">Student: own student record</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_student')])]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        </record>

        <record id="school_student_parent_rule" model="ir.rule">
            <field name="name">Parent: linked children with portal access</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_parent')])]"/>
            <field name="domain_force">[('guardian_relation_ids.partner_id', '=', user.partner_id.id), ('guardian_relation_ids.can_view_portal', '=', True)]</field>
        </record>

        <record id="school_guardian_relation_teacher_rule" model="ir.rule">
            <field name="name">Teacher: guardian relations for taught classes</field>
            <field name="model_id" ref="model_school_guardian_relation"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_teacher')])]"/>
            <field name="domain_force">['|', ('student_id.class_id.class_teacher_id.user_id', '=', user.id), ('student_id.class_id.subject_ids.teacher_id.user_id', '=', user.id)]</field>
        </record>

        <record id="school_guardian_relation_parent_rule" model="ir.rule">
            <field name="name">Parent: own portal guardian relations</field>
            <field name="model_id" ref="model_school_guardian_relation"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_parent')])]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('can_view_portal', '=', True)]</field>
        </record>

        <record id="school_exam_result_student_rule" model="ir.rule">
            <field name="name">Student: own results</field>
            <field name="model_id" ref="model_school_exam_result"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_student')])]"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        </record>

        <record id="school_exam_result_parent_rule" model="ir.rule">
            <field name="name">Parent: linked children results</field>
            <field name="model_id" ref="model_school_exam_result"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_parent')])]"/>
            <field name="domain_force">[('student_id.guardian_relation_ids.partner_id', '=', user.partner_id.id), ('student_id.guardian_relation_ids.can_view_portal', '=', True)]</field>
        </record>

        <record id="school_exam_admin_rule" model="ir.rule">
            <field name="name">Exam Admin: view all exams</field>
            <field name="model_id" ref="model_school_exam"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_admin')])]"/>
            <field name="domain_force">[]</field>
        </record>

        <record id="school_exam_teacher_rule" model="ir.rule">
            <field name="name">Exam Teacher: view own exams only</field>
            <field name="model_id" ref="model_school_exam"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_teacher')])]"/>
            <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
        </record>

        <record id="school_exam_result_admin_rule" model="ir.rule">
            <field name="name">Exam Result Admin: view all results</field>
            <field name="model_id" ref="model_school_exam_result"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_admin')])]"/>
            <field name="domain_force">[]</field>
        </record>

        <record id="school_exam_result_teacher_rule" model="ir.rule">
            <field name="name">Exam Result Teacher: view own exam results only</field>
            <field name="model_id" ref="model_school_exam_result"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_teacher')])]"/>
            <field name="domain_force">[('exam_id.teacher_id.user_id', '=', user.id)]</field>
        </record>

        <record id="account_move_student_rule" model="ir.rule">
            <field name="name">Student: own invoices</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_student')])]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('move_type', 'in', ['out_invoice', 'out_refund'])]</field>
        </record>

        <record id="account_move_parent_rule" model="ir.rule">
            <field name="name">Parent: own invoices</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="groups" eval="[Command.set([ref('School_Management_System.group_school_parent')])]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('move_type', 'in', ['out_invoice', 'out_refund'])]</field>
        </record>

        <record id="student_admission_company_rule" model="ir.rule">
            <field name="name">Student Admission: multi-company</field>
            <field name="model_id" ref="model_student_admission"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="student_class_company_rule" model="ir.rule">
            <field name="name">Student Class: multi-company</field>
            <field name="model_id" ref="model_student_class"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="school_student_company_rule" model="ir.rule">
            <field name="name">School Student: multi-company</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="school_guardian_relation_company_rule" model="ir.rule">
            <field name="name">Guardian Relation: multi-company</field>
            <field name="model_id" ref="model_school_guardian_relation"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="school_teacher_company_rule" model="ir.rule">
            <field name="name">School Teacher: multi-company</field>
            <field name="model_id" ref="model_school_teacher"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="school_subject_company_rule" model="ir.rule">
            <field name="name">School Subject: multi-company</field>
            <field name="model_id" ref="model_school_subject"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="school_section_company_rule" model="ir.rule">
            <field name="name">School Section: multi-company</field>
            <field name="model_id" ref="model_school_section"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="school_exam_company_rule" model="ir.rule">
            <field name="name">School Exam: multi-company</field>
            <field name="model_id" ref="model_school_exam"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="school_exam_result_company_rule" model="ir.rule">
            <field name="name">School Exam Result: multi-company</field>
            <field name="model_id" ref="model_school_exam_result"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="school_exam_grade_company_rule" model="ir.rule">
            <field name="name">School Exam Grade: multi-company</field>
            <field name="model_id" ref="model_school_exam_grade"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="school_academic_year_company_rule" model="ir.rule">
            <field name="name">Academic Year: multi-company</field>
            <field name="model_id" ref="model_school_academic_year"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="school_term_company_rule" model="ir.rule">
            <field name="name">Term: multi-company</field>
            <field name="model_id" ref="model_school_term"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>