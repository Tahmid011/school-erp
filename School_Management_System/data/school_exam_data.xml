<odoo>
    <data noupdate="0">

        <record id="sequence_school_exam" model="ir.sequence">
            <field name="name">School Exam Reference Code</field>
            <field name="prefix">EX</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
            <field name="code">school.exam</field>
        </record>

        <record id="exam_grade_a_plus" model="school.exam.grade">
            <field name="name">A+</field>
            <field name="sequence">10</field>
            <field name="min_percentage">90</field>
            <field name="max_percentage">100</field>
            <field name="is_pass">True</field>
        </record>

        <record id="exam_grade_a" model="school.exam.grade">
            <field name="name">A</field>
            <field name="sequence">20</field>
            <field name="min_percentage">80</field>
            <field name="max_percentage">89.99</field>
            <field name="is_pass">True</field>
        </record>

        <record id="exam_grade_b_plus" model="school.exam.grade">
            <field name="name">B+</field>
            <field name="sequence">30</field>
            <field name="min_percentage">70</field>
            <field name="max_percentage">79.99</field>
            <field name="is_pass">True</field>
        </record>

        <record id="exam_grade_b" model="school.exam.grade">
            <field name="name">B</field>
            <field name="sequence">40</field>
            <field name="min_percentage">60</field>
            <field name="max_percentage">69.99</field>
            <field name="is_pass">True</field>
        </record>

        <record id="exam_grade_c" model="school.exam.grade">
            <field name="name">C</field>
            <field name="sequence">50</field>
            <field name="min_percentage">50</field>
            <field name="max_percentage">59.99</field>
            <field name="is_pass">True</field>
        </record>

        <record id="exam_grade_d" model="school.exam.grade">
            <field name="name">D</field>
            <field name="sequence">60</field>
            <field name="min_percentage">40</field>
            <field name="max_percentage">49.99</field>
            <field name="is_pass">True</field>
        </record>

        <record id="exam_grade_f" model="school.exam.grade">
            <field name="name">F</field>
            <field name="sequence">70</field>
            <field name="min_percentage">0</field>
            <field name="max_percentage">39.99</field>
            <field name="is_pass">False</field>
        </record>

    </data>
</odoo>