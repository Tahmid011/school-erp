<odoo>
    <data noupdate="0">
        <record id="sequence_student_admission" model="ir.sequence">
            <field name="name">Student Admission Application</field>
            <field name="prefix">ADM/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="code">student.admission</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="mail_template_admission_received" model="mail.template">
            <field name="name">Admission: Application Received</field>
            <field name="model_id" ref="model_student_admission"/>
            <field name="subject">Application ${object.application_number} received</field>
            <field name="email_from">${(object.company_id.email or user.email or '')}</field>
            <field name="email_to">${object.guardian_email or object.parent_contact or ''}</field>
            <field name="body_html" type="html">
                <p>Dear Applicant,</p>
                <p>We received application <strong>${object.application_number}</strong> for ${object.name}.</p>
            </field>
        </record>
        <record id="mail_template_admission_approved" model="mail.template">
            <field name="name">Admission: Approved</field>
            <field name="model_id" ref="model_student_admission"/>
            <field name="subject">Application ${object.application_number} approved</field>
            <field name="email_from">${(object.company_id.email or user.email or '')}</field>
            <field name="email_to">${object.guardian_email or object.parent_contact or ''}</field>
            <field name="body_html" type="html">
                <p>Application <strong>${object.application_number}</strong> for ${object.name} has been approved.</p>
            </field>
        </record>
        <record id="mail_template_admission_rejected" model="mail.template">
            <field name="name">Admission: Rejected</field>
            <field name="model_id" ref="model_student_admission"/>
            <field name="subject">Application ${object.application_number} update</field>
            <field name="email_from">${(object.company_id.email or user.email or '')}</field>
            <field name="email_to">${object.guardian_email or object.parent_contact or ''}</field>
            <field name="body_html" type="html">
                <p>Application <strong>${object.application_number}</strong> for ${object.name} was not approved.</p>
            </field>
        </record>
        <record id="mail_template_admission_admitted" model="mail.template">
            <field name="name">Admission: Admitted</field>
            <field name="model_id" ref="model_student_admission"/>
            <field name="subject">Application ${object.application_number} admitted</field>
            <field name="email_from">${(object.company_id.email or user.email or '')}</field>
            <field name="email_to">${object.guardian_email or object.parent_contact or ''}</field>
            <field name="body_html" type="html">
                <p>${object.name} has been admitted. The student record is now available.</p>
            </field>
        </record>
    </data>
</odoo>
